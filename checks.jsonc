    },
    {
      "id": "FBK-001",
      "title": "Legacy/external-contract heuristics применены к границам адаптации",
      "pack": "references/review-feedback.md",
      "owner": "behavior-guard-scout",
      "mandatory_for": ["real-code"],
      "applies_if": "scope.real_code && scope.legacy_or_external_boundary",
      "phase": ["scan", "fix"],
      "kind": "default",
      "autofix": false,
      "rerun_after_fix": true
    },
    {
      "id": "SAF-001",
      "title": "Behavior-change guard применен к реальным правкам и опасным маркерам diff-а",
      "pack": "references/behavior-change-guard.md",
      "owner": "behavior-guard-scout",
      "mandatory_for": ["consultation", "real-code"],
      "applies_if": "(scope.real_code && (scope.bsl_code || scope.changed_files)) || scope.topic_behavior_safety",
      "phase": ["scan", "verify"],
      "kind": "hard",
      "autofix": false,
      "rerun_after_fix": true
    },
    {
      "id": "SAF-002",
      "title": "Не введены необоснованные defensive/normalization-обертки и дрейф контракта",
      "pack": "references/behavior-change-guard.md",
      "owner": "behavior-guard-scout",
      "mandatory_for": ["real-code"],
      "applies_if": "scope.real_code && scope.bsl_code",
      "phase": ["scan", "fix"],
      "kind": "hard",
      "autofix": false,
      "rerun_after_fix": true
    },
    {
      "id": "VRF-001",
      "title": "Машинные verify-checks выполнены по каждому измененному файлу или честно задокументирован fallback",
      "pack": "process/verify-recipes.md",
      "owner": "final-verifier",
      "mandatory_for": ["real-code"],
