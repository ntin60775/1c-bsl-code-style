    },
    {
      "id": "VRF-002",
      "title": "Judgement-verify выполнен по dangerous diff markers и границам контракта",
      "pack": "process/verify-recipes.md",
      "owner": "final-verifier",
      "mandatory_for": ["real-code"],
      "applies_if": "scope.real_code && scope.changed_files",
      "phase": ["verify"],
      "kind": "hard",
      "autofix": false,
      "rerun_after_fix": false
    },
    {
      "id": "HGT-001",
      "title": "Hard-gates пройдены перед финальным ответом",
      "pack": "process/hard-gates.md",
      "owner": "final-verifier",
      "mandatory_for": ["consultation", "real-code", "skill-audit"],
      "applies_if": "always",
      "phase": ["report"],
      "kind": "hard",
      "autofix": false,
      "rerun_after_fix": false
    },
    {
      "id": "HUR-001",
      "title": "Финальная эвристическая самопроверка выполнена",
      "pack": "process/review-heuristics.md",
